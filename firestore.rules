rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@mayankzen.in' ||
        request.auth.token.email == 'mayank198010@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@mayankzen.in' ||
        request.auth.token.email == 'mayank198010@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/approvedAdmins/$(request.auth.uid)))
      );
    }

    // Service Requests: public clients can submit and track; authorized admins can manage/update/delete
    match /service_requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.trackingId is string;
      allow update, delete: if isAdmin();
    }

    // User Profiles: accessible by the authenticated user or authorized admin
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isMasterAdmin();
    }

    // Approved Admins List: readable by authenticated users, writable by authorized admin
    match /approvedAdmins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Chat Rooms and Messages: direct collaboration channel for client tracking and live support
    match /chat_rooms/{roomId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
